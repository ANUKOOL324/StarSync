PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Application runtime (Neon pooled connection).
# Use the pooler hostname, which normally contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Prisma CLI only (migrate deploy, db seed, etc.).
# Use the direct Neon connection. Hostname must NOT contain "-pooler".
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"


# Local Piston is recommended for development because the public Piston /execute
# endpoint can reject unauthenticated requests.
# Start it with: docker compose -f docker-compose.piston.yml up -d
CODE_RUNNER_URL=http://localhost:2000/api/v2

# Required only for the collaborative whiteboard.
# Get this from the Liveblocks dashboard API keys page.
LIVEBLOCKS_SECRET_KEY=your_liveblocks_secret_key

# Redis-backed HttpOnly session auth.
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=604800
