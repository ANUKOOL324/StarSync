PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Use your own PostgreSQL connection string.
# Neon URLs usually include sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Use a long random secret in real projects.
# This signs REST and WebSocket JWT tokens.
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Local Piston is recommended for development because the public Piston /execute
# endpoint can reject unauthenticated requests.
# Start it with: docker compose -f docker-compose.piston.yml up -d
CODE_RUNNER_URL=http://localhost:2000/api/v2

# Required only for the collaborative whiteboard.
# Get this from the Liveblocks dashboard API keys page.
LIVEBLOCKS_SECRET_KEY=your_liveblocks_secret_key
